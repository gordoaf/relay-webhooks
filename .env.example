# Generate a random token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_ADMIN_TOKEN=
RELAY_DB_PATH=data/relay.db
RELAY_ALLOW_PRIVATE_NETWORKS=false
RELAY_WORKER_ENABLED=true
RELAY_WORKER_CONCURRENCY=4
# Optional separate random token for read-only Prometheus scraping (24+ characters).
RELAY_METRICS_TOKEN=
# Set the exact browser-facing origin when using an HTTPS reverse proxy.
# Example: https://relay.example.com (no path, query, or fragment).
RELAY_PUBLIC_URL=

# Retention is opt-in. Review relay cleanup before enabling deletion.
RELAY_RETENTION_DAYS=0
RELAY_IDEMPOTENCY_DAYS=90
RELAY_CLEANUP_BATCH_SIZE=100
RELAY_MIN_FREE_BYTES=0
RELAY_MAX_STORAGE_BYTES=0
RELAY_STORAGE_WARNING_PERCENT=90
RELAY_QUEUE_WARNING_AGE_SECONDS=300
RELAY_FAILURE_WARNING_PERCENT=25
RELAY_FAILURE_MIN_SAMPLES=10
RELAY_ALERT_WEBHOOK_URL=
RELAY_ALERT_SIGNING_SECRET=
RELAY_ALERT_COOLDOWN_SECONDS=3600
RELAY_MAINTENANCE_INTERVAL_SECONDS=30
RELAY_MAINTENANCE_ENABLED=true
