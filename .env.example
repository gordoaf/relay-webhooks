# Generate a random token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_ADMIN_TOKEN=
RELAY_DB_PATH=data/relay.db
RELAY_ALLOW_PRIVATE_NETWORKS=false
RELAY_WORKER_ENABLED=true
# Set the exact browser-facing origin when using an HTTPS reverse proxy.
# Example: https://relay.example.com (no path, query, or fragment).
RELAY_PUBLIC_URL=
